# Copy to .env.local and fill in. Next.js and the Payload CLI read .env.local; never commit it.

# Postgres connection string of your own Neon development branch (README § Development database). Never production's.
DATABASE_URL=

# Signs Payload's login tokens. Any long random string, e.g. the output of `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Outgoing email (Scaleway Transactional Email). Leave all four SMTP_* empty locally: emails are then printed to the terminal.
# SMTP server: smtp.tem.scaleway.com
SMTP_HOST=
# 587 (STARTTLS). Never 25; Vercel blocks it.
SMTP_PORT=
# Scaleway Project ID of the Transactional Email domain (Transactional Email → Domain Overview).
SMTP_USER=
# Secret key of a Scaleway API key whose only permission set is TransactionalEmailEmailSmtpCreate.
SMTP_PASS=
# Sender as "Name <address>". Empty means Zeitleiste <noreply@bennoselig.dev>.
EMAIL_FROM=

# Public origin of the app, e.g. https://zeitleiste.bennoselig.dev (no path, no trailing slash). Links in invitation and reset emails
# point here, and Payload accepts login cookies only from it. Empty means: the production domain on Vercel production, the deployment
# URL on Vercel previews, http://localhost:3000 locally. Set it when running on another port.
SERVER_URL=
